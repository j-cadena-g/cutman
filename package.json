{
  "name": "cutman",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @cutman/web run dev",
    "dev:verify": "pnpm --filter @cutman/web run dev:verify",
    "build": "turbo build --filter=@cutman/web",
    "wrangler:deploy-config": "pnpm --filter @cutman/web run wrangler:deploy-config",
    "deploy": "pnpm --filter @cutman/web run deploy",
    "db:migrate:local": "pnpm --filter @cutman/web run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @cutman/web run db:migrate:remote",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "cf-typegen": "pnpm --filter @cutman/web cf-typegen"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
