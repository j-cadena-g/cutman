# =============================================================================
# CUTMAN - Deploy-time config (names only)
# =============================================================================
# Binding IDs and Worker vars rendered into apps/web/.wrangler.deploy.jsonc from
# process.env (injected by op run from your 1Password Environment).
# Worker secrets are listed in apps/web/.wrangler.secrets.example and uploaded on
# deploy via wrangler deploy --secrets-file (also sourced from your Environment).
# Do not put these Cloudflare IDs in local .dev.vars.
# V1_* are required live Sleeper league/user identifiers at deploy time.
# Tracked wrangler.jsonc keeps fake placeholders; this Environment supplies
# the real values so production cannot seed example identities.
# =============================================================================

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_CUSTOM_DOMAIN=
CLERK_PUBLISHABLE_KEY=
APP_ENV=production
APP_ORIGIN=https://cutman.io
V1_LEAGUE_ID=
V1_LEAGUE_NAME=
V1_SLEEPER_USER_ID=
V1_SLEEPER_USERNAME=
