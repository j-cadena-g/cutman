{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cutman-test",
  "main": "./workers/test-entry.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "http://127.0.0.1:41789",
    "EMAIL_FROM": "Cutman <hello@mail.cutman.io>",
    "USE_SLEEPER_FIXTURES": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cutman-test",
      "database_id": "local-cutman-test",
      "migrations_dir": "./d1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PLAYERS",
      "id": "test-players-kv"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEAGUE_BRAIN",
        "class_name": "LeagueBrain"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LeagueBrain"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
