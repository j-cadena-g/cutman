{
  "name": "@cutman/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash ../../scripts/run-with-1password-environment.sh -- node ../../scripts/run-vite-dev.mjs vite dev",
    "dev:verify": "bash ../../scripts/run-with-1password-environment.sh -- node ../../scripts/verify-dev-environment.mjs",
    "build": "react-router build",
    "preview": "pnpm build && vite preview --port 41789",
    "wrangler:deploy-config": "node ../../scripts/render-wrangler-deploy-config.mjs",
    "deploy": "bash ../../scripts/run-with-1password-environment.sh -- pnpm run deploy:internal",
    "deploy:internal": "bash ../../scripts/deploy-with-secrets.sh",
    "db:migrate:local": "pnpm exec wrangler d1 migrations apply cutman --local --config wrangler.jsonc",
    "db:reset:local": "node ../../scripts/reset-local-d1.mjs && pnpm run db:migrate:local",
    "db:migrate:remote": "bash ../../scripts/run-with-1password-environment.sh -- pnpm run db:migrate:remote:internal",
    "db:migrate:remote:internal": "pnpm run wrangler:deploy-config && pnpm exec wrangler d1 migrations apply cutman --remote --config .wrangler.deploy.jsonc",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run && node --test ../../scripts/render-wrangler-deploy-config.test.mjs",
    "lint": "echo ok"
  },
  "dependencies": {
    "@clerk/react-router": "^3.6.20",
    "@cutman/ai": "workspace:*",
    "@cutman/db": "workspace:*",
    "@cutman/email": "workspace:*",
    "@cutman/sleeper": "workspace:*",
    "@cutman/story": "workspace:*",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.32",
    "lucide-react": "^0.562.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "catalog:",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260902.1",
    "@cutman/tsconfig": "workspace:*",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.17",
    "typescript": "catalog:",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
