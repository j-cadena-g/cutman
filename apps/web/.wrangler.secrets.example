# =============================================================================
# CUTMAN - Worker secrets (names only)
# =============================================================================
# Manifest for wrangler deploy --secrets-file. Values come from process.env
# (injected by op run from your 1Password Environment). Same keys belong in
# your local-dev and production Environments with environment-appropriate values.
# PILOT_SLEEPER_LEAGUE_ID is a wrangler var rendered from your Environment into
# the ignored deploy/dev config. Tracked wrangler.jsonc keeps a fake placeholder.
# =============================================================================

CLERK_SECRET_KEY=
