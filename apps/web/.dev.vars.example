# =============================================================================
# CUTMAN - Local Development Secrets
# =============================================================================
# Key manifest for local Workers dev. `pnpm run dev` uses op run to inject these
# keys into process.env; Wrangler reads them via CLOUDFLARE_INCLUDE_PROCESS_ENV.
# `pnpm run dev:verify` requires the keys in the Required section (names only;
# no values printed). Optional PILOT_SLEEPER_LEAGUE_ID may be unset for a first
# run (wrangler.jsonc keeps a fake placeholder). Do not create, mount, or commit
# `.dev.vars`. Cloudflare account / zone / D1 / KV IDs belong in
# apps/web/.deploy.env.example. Worker secrets for deploy live in
# apps/web/.wrangler.secrets.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — enough for first `pnpm run dev`
# -----------------------------------------------------------------------------
APP_ENV=development
# Must match the Vite / Wrangler local preview port (41789).
APP_ORIGIN=http://127.0.0.1:41789

# Clerk authentication (create your own Clerk application; use pk_test_ / sk_test_)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# Optional — pilot league identity (override via 1Password; this value is fake)
# Live Sleeper league id belongs in gitignored / 1Password config, not git.
# -----------------------------------------------------------------------------
PILOT_SLEEPER_LEAGUE_ID=0000000000000000000
USE_SLEEPER_FIXTURES=false
